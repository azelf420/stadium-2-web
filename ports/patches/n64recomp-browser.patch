+    // n64-web: graphics quality, chosen on the page (globalThis.n64webQuality, or n64web_set_quality while the game
+    // runs): 0 the N64's own resolution (light: phones, weak graphics), 1 twice that, 2 the canvas's resolution in whole
+    // multiples of 240 lines. Applied on the renderer's thread at the next display list.
+    std::atomic<int> quality_request{-1};
+    void apply_quality(RT64::Application *app, int quality, bool update) {
+        app->userConfig.resolution = quality <= 0 ? RT64::UserConfiguration::Resolution::Original
+                                   : quality == 1 ? RT64::UserConfiguration::Resolution::Manual
+                                                  : RT64::UserConfiguration::Resolution::WindowIntegerScale;
+        app->userConfig.resolutionMultiplier = 2.0;
+        fprintf(stderr, "[n64web-res] graphics quality %d\n", quality);
+        if (update) app->updateUserConfig(true);
+    }
